{
  "name": "invitation-miniprogram",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.13.0 <25" },
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src config tests scripts",
    "test": "tsx --test tests/*.test.ts",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run check:assets && npm run build:weapp && npm run check:bundle"
  },
  "dependencies": {
    "@babel/runtime": "7.28.4",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-react": "7.28.5",
    "@tarojs/cli": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "18.3.28",
    "babel-preset-taro": "4.2.1",
    "oxlint": "1.76.0",
    "react-refresh": "0.14.2",
    "sass": "1.97.3",
    "sharp": "0.34.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "webpack": "5.91.0"
  }
}
